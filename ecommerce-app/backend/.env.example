# Salin file ini menjadi ".env" lalu isi sesuai kebutuhanmu

# MongoDB connection string (lokal atau MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db

# Port server backend
PORT=5000

# Secret key untuk JWT (ganti dengan string acak yang panjang & aman)
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia

# Masa berlaku token
JWT_EXPIRE=7d

# URL frontend (untuk CORS)
CLIENT_URL=http://localhost:5173

# Kredensial akun admin default yang dibuat saat seeding
ADMIN_EMAIL=admin@toko.com
ADMIN_PASSWORD=admin123
